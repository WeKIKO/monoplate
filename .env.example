NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monoplate
LOG_LEVEL=info
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=http://localhost:4321,http://localhost:5173
API_BODY_LIMIT_BYTES=1048576
API_REQUEST_TIMEOUT_MS=15000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_STATEMENT_TIMEOUT_MS=10000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=monoplate-api
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEV_HOST=
EXPO_PUBLIC_MINIMUM_APP_VERSION=0.1.0
EXPO_PUBLIC_RECOMMENDED_APP_VERSION=
EXPO_PUBLIC_APP_STORE_URL=
APP_ASSOCIATED_DOMAIN=
APP_LINK_HOST=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
EXPO_TOKEN=
EAS_PROJECT_ID=
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=development
