{
  "name": "@monoplate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --sourcemap && esbuild src/migrate.ts --bundle --platform=node --format=esm --outfile=dist/migrate.mjs --sourcemap",
    "start": "node dist/server.cjs",
    "auth:bootstrap": "tsx src/bootstrap-admin.ts",
    "openapi:generate": "tsx src/generate-openapi.ts",
    "openapi:check": "tsx src/generate-openapi.ts --check",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^1.6.3",
    "@monoplate/contracts": "workspace:*",
    "@monoplate/auth": "workspace:*",
    "@monoplate/config": "workspace:*",
    "@monoplate/database": "workspace:*",
    "@monoplate/errors": "workspace:*",
    "@monoplate/health": "workspace:*",
    "@monoplate/logger": "workspace:*",
    "@monoplate/postgres-adapters": "workspace:*",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "pino": "^9.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@monoplate/typescript-config": "workspace:*",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
