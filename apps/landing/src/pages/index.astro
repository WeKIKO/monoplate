---
import BaseLayout from "#landing/layouts/BaseLayout.astro";
import { appPath } from "@monoplate/ui/core";
import "@monoplate/design-tokens/css";
import "@monoplate/ui/css";
---
<BaseLayout><main id="content"><p>MONOPLATE</p><h1>Build the product, not the foundation.</h1><p>API, mobile, admin, landing, contracts and deployment—ready to shape.</p><a href={appPath({ route: "settings" })}>Explore the foundation →</a></main></BaseLayout>
<style is:global>body{margin:0;background:var(--color-foreground);color:var(--color-background);font-family:var(--font-body),system-ui,sans-serif}main{max-width:70rem;margin:auto;padding:12vh 2rem}p{color:#b8c4d8}h1{font-family:var(--font-heading),system-ui;font-size:clamp(3rem,9vw,7rem);line-height:.95;max-width:12ch;margin:2rem 0}main a{display:inline-block;margin-top:2rem;color:white;background:var(--color-primary);padding:1rem 1.25rem;border-radius:var(--radius-md);text-decoration:none}.skip-link{position:fixed;top:.5rem;left:.5rem;transform:translateY(-150%);padding:.75rem;background:white;color:#111}.skip-link:focus{transform:none}</style>
